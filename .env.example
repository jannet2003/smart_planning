# =============================================================
# SmartPlanning Radiologie — Variables d'environnement
# Copie ce fichier en .env et renseigne les valeurs réelles.
# Le fichier .env NE doit PAS être commité dans git.
# =============================================================

# URL de la base de données SQLite (chemin absolu recommandé sur VPS)
# Par défaut, la config.py calcule le chemin automatiquement.
# Décommente et adapte si tu veux surcharger :
# DATABASE_URL=sqlite:////srv/smartplanning/data/planning.db

# Environnement (development | production)
APP_ENV=production

# Origines CORS autorisées (séparées par des virgules)
# En production, remplace * par ton domaine
# ALLOWED_ORIGINS=https://mondomaine.fr,https://www.mondomaine.fr
ALLOWED_ORIGINS=*

# Port d'écoute d'Uvicorn (Nginx fait le reverse-proxy sur ce port)
PORT=8000
