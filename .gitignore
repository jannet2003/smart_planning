# =============================================================
# SmartPlanning Radiologie — .gitignore
# =============================================================

# ── Environnement virtuel Python ──────────────────────────────
.venv/
venv/
env/

# ── Fichiers compilés Python ──────────────────────────────────
**/__pycache__/
*.py[cod]
*.pyo
*.pyc

# ── Tests ─────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Base de données ───────────────────────────────────────────
# data/planning.db est conservé dans le dépôt pour initialiser les données directement après clonage/pull
backend/planning.db
data/*.bak
data/*_backup*
data/*_copy*
*.db-shm
*.db-wal

# ── Variables d'environnement (JAMAIS commiter .env) ─────────
.env
.env.local
.env.production

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Fichiers PID / runtime ───────────────────────────────────
*.pid

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── Sous-module / clone interne (obsolète) ───────────────────
radiologie-planning/

# ── Fichiers temporaires Office ───────────────────────────────
*.docx
~$*
