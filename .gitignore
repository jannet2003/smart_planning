# Environnement virtuel Python
.venv/

# Fichiers compilés Python
**/__pycache__/
*.py[cod]
*.pyo
*.pyc

# Fichiers cache pytest
.pytest_cache/

# Base de données locale - on garde data/planning.db dans le repo
# pour que le projet soit utilisable directement après clonage
backend/planning.db
data/*.bak
data/*_backup*
data/*_copy*

# Dossier généré par le sous-module / clone interne
radiologie-planning/

# Fichiers de configuration IDE
.vscode/
.idea/
*.suo
*.user

# Logs
*.log

# Variables d'environnement
.env
.env.local

# Fichiers temporaires Office
*.docx
~$*
